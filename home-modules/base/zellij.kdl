default_mode "locked"
keybinds clear-defaults=true {
    normal {
        bind "p" { SwitchToMode "Pane"; }
        bind "r" { SwitchToMode "Resize"; }
        bind "s" { SwitchToMode "Scroll"; }
        bind "o" { SwitchToMode "Session"; }
        bind "t" { SwitchToMode "Tab"; }
        bind "m" { SwitchToMode "Move"; }
    }
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }

        bind "Alt t" { NewTab; }
        bind "Alt i" { GoToPreviousTab; }
        bind "Alt o" { GoToNextTab; }
        bind "Alt Tab" { ToggleTab; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }

        bind "Alt p" { NewPane; }
        bind "Alt h" { MoveFocus "Left"; }
        bind "Alt l" { MoveFocus "Right"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt w" { ToggleFloatingPanes; }

        bind "Alt =" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
        bind "Alt m" { TogglePaneInGroup; }
        bind "Alt Shift m" { ToggleGroupMarking; }
    }
    resize {
        bind "h" { Resize "Increase Left"; }
        bind "j" { Resize "Increase Down"; }
        bind "k" { Resize "Increase Up"; }
        bind "l" { Resize "Increase Right"; }

        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }

        bind "=" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }
    pane {
        bind "n" { NewPane; SwitchToMode "Locked"; }
        bind "s" { NewPane "stacked"; SwitchToMode "Locked"; }
        bind "h" { NewPane "Left"; SwitchToMode "Locked"; }
        bind "j" { NewPane "Down"; SwitchToMode "Locked"; }
        bind "k" { NewPane "Up"; SwitchToMode "Locked"; }
        bind "l" { NewPane "Right"; SwitchToMode "Locked"; }

        bind "x" { CloseFocus; SwitchToMode "Locked"; }
        bind "r" { SwitchToMode "RenamePane"; PaneNameInput 0;}
        bind "p" { TogglePanePinned; SwitchToMode "Locked"; }

        bind "f" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "Shift f" { ToggleFocusNoUiFullscreen; SwitchToMode "Locked"; }

        bind "w" { TogglePaneEmbedOrFloating; SwitchToMode "Locked"; }
    }
    move {
        bind "n" { MovePane; }
        bind "p" { MovePaneBackwards; }

        bind "h" { MovePane "Left"; }
        bind "j" { MovePane "Down"; }
        bind "k" { MovePane "Up"; }
        bind "l" { MovePane "Right"; }

        bind "i" { MoveTab "Left"; }
        bind "o" { MoveTab "Right"; }
    }
    tab {
        bind "n" { NewTab; SwitchToMode "Locked"; }
        bind "x" { CloseTab; SwitchToMode "Locked"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }

        bind "b" { BreakPane; SwitchToMode "Locked"; }
        bind "i" { BreakPaneLeft; SwitchToMode "Locked"; }
        bind "o" { BreakPaneRight; SwitchToMode "Locked"; }

        // sync inputs between all panes in the tab
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Locked"; }
    }
    scroll {
        bind "Esc" { ScrollToBottom; SwitchToMode "Locked"; }
        bind "/" { SwitchToMode "EnterSearch"; } // add `SearchInput 0;` to reset

        bind "e" { EditScrollback; SwitchToMode "Locked"; }

        bind "v" { SelectCommandAtScrollPosition; }
        bind "y" { CopyLastCommandOutput; SwitchToMode "Locked"; }
    }
    search {
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "/" { SwitchToMode "EnterSearch"; }

        bind "n" { Search "down"; }
        bind "p" "N" { Search "up"; }

        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }
    entersearch {
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "Locked"; }
    }
    renamepane {
        bind "Esc" { UndoRenamePane; SwitchToMode "Locked"; }
    }
    session {
        bind "d" { Detach; }
        bind "]" { FocusHostSession; SwitchToMode "Locked"; }
        bind "[" { FocusGuestSession; SwitchToMode "Locked"; }
        bind "f" { ToggleHostFullscreen; SwitchToMode "Locked"; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Locked"
        }
    }
    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "Locked"; }
        bind "Enter" { SwitchToMode "Locked"; }
        bind "Esc" { SwitchToMode "Locked"; }
    }
    shared_among "scroll" "search" {
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "Ctrl f" { PageScrollDown; }
        bind "Ctrl b" { PageScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
    }
}

plugins {
    compact-bar location="zellij:compact-bar" {
        tooltip "" // don't need the hotkey since tooltip appears on ctrl-g
    }
}

show_startup_tips false
show_release_notes false

default_layout "compact"
simplified_ui true
pane_frames false

copy_on_select false
session_serialization false
