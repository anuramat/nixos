# Z5II maker note tags unknown to exiftool, found by diffing shots with the setting toggled
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::Nikon::Main' => {
        0x0055 => {
            Name => 'DiffractionCompensation',
            Condition => '$$self{Model} =~ /^NIKON Z5_2\b/',
            ValueConv => 'unpack("x4C", $val)',
            PrintConv => { 0 => 'Off', 1 => 'On' },
        },
    },
);
1;
