Convert the plugin API's fileInfo mtime to system time without jitter.

The conversion offset came from two separate now() calls, one per clock, so
it drifted by the time between them, and the same file's mtime could differ
from call to call. file_clock::to_sys converts exactly, so plugins can tell a
rewritten file from an unchanged one by comparing mtimes.

--- a/src/scripting/luau_host.cpp
+++ b/src/scripting/luau_host.cpp
@@ -1118,9 +1118,7 @@
     }
     double mtime = 0.0;
     if (const auto writeTime = std::filesystem::last_write_time(target, ec); !ec) {
-      const auto sysTime = std::chrono::time_point_cast<std::chrono::system_clock::duration>(
-          writeTime - std::filesystem::file_time_type::clock::now() + std::chrono::system_clock::now()
-      );
+      const auto sysTime = std::chrono::file_clock::to_sys(writeTime);
       mtime = std::chrono::duration<double>(sysTime.time_since_epoch()).count();
     }
     lua_createtable(L, 0, 3);
