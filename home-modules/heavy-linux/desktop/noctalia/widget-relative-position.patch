+  // The config stores cx/cy as fractions of the widget's output's logical size, so that widgets keep
+  // their relative placement when the output is rotated or rescaled. The editor works in logical px:
+  // it converts its snapshot with toPx on open and back on close. Widgets without an available
+  // output are left as is, both ways.
+  inline void convertCenter(const WaylandConnection& wayland, DesktopWidgetState& state, bool toPx) {
+    const WaylandOutput* output = resolveStateOutput(wayland, state);
+    if (output == nullptr) {
+      return;
+    }
+    const float w = outputLogicalWidth(*output);
+    const float h = outputLogicalHeight(*output);
+    state.cx = toPx ? state.cx * w : state.cx / w;
+    state.cy = toPx ? state.cy * h : state.cy / h;
+  }
+
+  // The widget's center in logical px of the output, from its fractional cx/cy, constrained so
+  // that at least kDesktopWidgetMinVisibleFraction of its rotated AABB remains on screen.
+  inline WidgetTransformClampResult
+  centerOnOutput(const WaylandOutput& output, const DesktopWidgetState& state, float width, float height) {
+    const float w = outputLogicalWidth(output);
+    const float h = outputLogicalHeight(output);
+    return clampWidgetCenterToOutput(
+        state.cx * w, state.cy * h, width, height, 1.0F, state.rotationRad, w, h, kDesktopWidgetMinVisibleFraction
+    );
+  }
+
+  // The editor's coordinate clamping, on states in logical px (see convertCenter). Resolves the
+  // widget's effective output, then constrains state.cx/cy so that at least
   // kDesktopWidgetMinVisibleFraction of the widget's rotated AABB remains on screen. The caller
   // passes the widget's current box size as intrinsicWidth/intrinsicHeight, so no extra scale
   // multiplier is applied here.
