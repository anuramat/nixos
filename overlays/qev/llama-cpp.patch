+def typesafe_images(body: Any) -> Any:
+    """TypeSafe's images as `media` with `<image:N>` placeholders: top-level `images` / `files` (URLs or data URLs)
+    before the state, and the `image` / `image_url` parts of a chat state in their place."""
+    if not isinstance(body, dict):
+        return body
+    media = body.get("media") or []
+
+    def image(src: str) -> str:
+        media.append({"type": "image", ("data" if src.startswith("data:") else "url"): src})
+        return f"<image:{len(media)}>"
+
+    def walk(x: Any) -> Any:
+        if isinstance(x, list):
+            return [walk(v) for v in x]
+        if isinstance(x, dict) and x.get("type") in ("image", "image_url"):
+            return image(x.get("image") or x.get("url") or (x.get("image_url") or {}).get("url"))
+        if isinstance(x, dict):
+            return {k: walk(v) for k, v in x.items()}
+        return x
+
+    top = "".join(image(src) for k in ("images", "files") for src in body.pop(k, None) or [])
+    state = walk(body.get("state"))
+    body["state"] = top + "\n" + render_state(state) if top else state
+    body["media"] = media or None
+    return body
+
+
 def _validation_error(exc: ValidationError) -> JSONResponse:
     detail = [{"loc": ["body", *[str(x) for x in e["loc"]]], "msg": e["msg"], "type": e["type"]} for e in exc.errors()]
     return JSONResponse(status_code=422, content={"detail": detail})
