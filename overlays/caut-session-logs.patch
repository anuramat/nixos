+fn codex_token_count<'a>(value: &'a Value, last_total: &mut Option<Value>) -> Option<&'a Value> {
+    let info = value.pointer("/payload/info")?;
+    let total = info.get("total_token_usage")?;
+    if last_total.as_ref() == Some(total) {
+        return None;
+    }
+    *last_total = Some(total.clone());
+    info.get("last_token_usage")
