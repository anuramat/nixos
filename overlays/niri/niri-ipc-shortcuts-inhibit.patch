+    pub fn ipc_refresh_shortcuts_inhibit(&mut self) {
+        let Some(server) = &self.niri.ipc_server else {
+            return;
+        };
+
+        let mut state = server.event_stream_state.borrow_mut();
+        let state = &mut state.shortcuts_inhibit;
+        let is_inhibiting = self.is_inhibiting_shortcuts();
+
+        if state.is_inhibiting == is_inhibiting {
+            return;
+        }
+
+        let event = Event::KeyboardShortcutsInhibitChanged { is_inhibiting };
+        state.apply(event.clone());
+        server.send_event(event);
+    }
