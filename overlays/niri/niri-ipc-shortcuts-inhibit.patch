+impl EventStreamStatePart for ShortcutsInhibitState {
+    fn replicate(&self) -> Vec<Event> {
+        vec![Event::KeyboardShortcutsInhibitChanged {
+            is_inhibiting: self.is_inhibiting,
+        }]
+    }
+
+    fn apply(&mut self, event: Event) -> Option<Event> {
+        match event {
+            Event::KeyboardShortcutsInhibitChanged { is_inhibiting } => {
+                self.is_inhibiting = is_inhibiting;
+            }
+            event => return Some(event),
+        }
+        None
+    }
+}
