+/// OAuth health from an access token's health and, if present, a refresh token's.
+fn oauth_health(access: JwtHealth, refresh: Option<JwtHealth>) -> CredentialHealth {
+    CredentialHealth::OAuth(match refresh {
+        Some(refresh) => OAuthHealth::with_refresh(access, refresh),
+        None => OAuthHealth::access_only(access),
+    })
+}
