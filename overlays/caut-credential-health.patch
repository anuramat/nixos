+/// Health of a refresh token: a JWT's expiry, if it is one; refresh tokens are
+/// usually opaque (Codex's `rt.1...`), with an unknown expiry.
+fn refresh_token_health(checker: &JwtHealthChecker, token: &str) -> JwtHealth {
+    match checker.check(token) {
+        JwtHealth::Invalid { .. } => JwtHealth::NoExpiration,
+        health => health,
     }
 }
 
