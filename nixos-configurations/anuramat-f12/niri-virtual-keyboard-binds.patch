diff --git a/src/handlers/virtual_keyboard.rs b/src/handlers/virtual_keyboard.rs
new file mode 100644
index 0000000..9ce81ff
--- /dev/null
+++ b/src/handlers/virtual_keyboard.rs
@@ -0,0 +1,102 @@
+use std::collections::HashSet;
+
+use smithay::input::keyboard::{xkb, Keycode};
+use smithay::reexports::wayland_protocols_misc::zwp_virtual_keyboard_v1::server::zwp_virtual_keyboard_manager_v1::ZwpVirtualKeyboardManagerV1;
+use smithay::reexports::wayland_protocols_misc::zwp_virtual_keyboard_v1::server::zwp_virtual_keyboard_v1::{
+    Request, ZwpVirtualKeyboardV1,
+};
+use smithay::reexports::wayland_server::backend::ClientId;
+use smithay::reexports::wayland_server::protocol::wl_keyboard::KeymapFormat;
+use smithay::reexports::wayland_server::{
+    delegate_dispatch, delegate_global_dispatch, Client, DataInit, Dispatch, DisplayHandle,
+    Resource,
+};
+use smithay::wayland::virtual_keyboard::{
+    VirtualKeyboardManagerGlobalData, VirtualKeyboardManagerState, VirtualKeyboardUserData,
+};
+
+use crate::niri::State;
+
+/// A copy of a virtual keyboard's XKB state, to match its keys against the binds.
+pub struct VirtualKeyboardBinds {
+    pub xkb: xkb::State,
+    pub suppressed_keys: HashSet<Keycode>,
+}
+
+// The manager is Smithay's; the keyboards are intercepted below.
+delegate_global_dispatch!(State: [ZwpVirtualKeyboardManagerV1: VirtualKeyboardManagerGlobalData] => VirtualKeyboardManagerState);
+delegate_dispatch!(State: [ZwpVirtualKeyboardManagerV1: ()] => VirtualKeyboardManagerState);
+
+type Smithay = VirtualKeyboardManagerState;
+
+impl Dispatch<ZwpVirtualKeyboardV1, VirtualKeyboardUserData<State>> for State {
+    fn request(
+        state: &mut Self,
+        client: &Client,
+        resource: &ZwpVirtualKeyboardV1,
+        request: Request,
+        data: &VirtualKeyboardUserData<State>,
+        dh: &DisplayHandle,
+        data_init: &mut DataInit<'_, Self>,
+    ) {
+        match &request {
+            Request::Keymap { format, fd, size } if *format == KeymapFormat::XkbV1 as u32 => {
+                let context = xkb::Context::new(xkb::CONTEXT_NO_FLAGS);
+                // SAFETY: Smithay maps the same keymap below.
+                let keymap = fd.try_clone().ok().and_then(|fd| unsafe {
+                    xkb::Keymap::new_from_fd(
+                        &context,
+                        fd,
+                        *size as usize,
+                        xkb::KEYMAP_FORMAT_TEXT_V1,
+                        xkb::KEYMAP_COMPILE_NO_FLAGS,
+                    )
+                    .ok()
+                    .flatten()
+                });
+                if let Some(keymap) = keymap {
+                    let binds = VirtualKeyboardBinds {
+                        xkb: xkb::State::new(&keymap),
+                        suppressed_keys: HashSet::new(),
+                    };
+                    state.niri.virtual_keyboards.insert(resource.id(), binds);
+                }
+            }
+            Request::Modifiers {
+                mods_depressed,
+                mods_latched,
+                mods_locked,
+                group,
+            } => {
+                if let Some(vk) = state.niri.virtual_keyboards.get_mut(&resource.id()) {
+                    vk.xkb
+                        .update_mask(*mods_depressed, *mods_latched, *mods_locked, 0, 0, *group);
+                }
+            }
+            // The protocol sends evdev codes, XKB's are offset by 8.
+            Request::Key {
+                key,
+                state: key_state,
+                ..
+            } => {
+                if state.intercept_virtual_key(&resource.id(), (key + 8).into(), *key_state == 1) {
+                    return;
+                }
+            }
+            _ => (),
+        }
+        <Smithay as Dispatch<_, _, State>>::request(
+            state, client, resource, request, data, dh, data_init,
+        );
+    }
+
+    fn destroyed(
+        state: &mut Self,
+        client: ClientId,
+        resource: &ZwpVirtualKeyboardV1,
+        data: &VirtualKeyboardUserData<State>,
+    ) {
+        state.niri.virtual_keyboards.remove(&resource.id());
+        <Smithay as Dispatch<_, _, State>>::destroyed(state, client, resource, data);
+    }
+}
