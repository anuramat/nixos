+    /// Matches a virtual keyboard's key against the binds, like on_keyboard() does for physical
+    /// keyboards, since Smithay forwards virtual keys straight to the focused client. Returns
+    /// whether the key was intercepted.
+    pub fn intercept_virtual_key(
+        &mut self,
+        id: &ObjectId,
+        key_code: Keycode,
+        pressed: bool,
+    ) -> bool {
+        let mod_key = self.backend.mod_key(&self.niri.config.borrow());
+        let is_inhibiting_shortcuts = self.is_inhibiting_shortcuts();
+        let Some(vk) = self.niri.virtual_keyboards.get_mut(id) else {
+            return false;
+        };
+
+        let mut mods = ModifiersState::default();
+        mods.update_with(&vk.xkb);
+        let modified = vk.xkb.key_get_one_sym(key_code);
+        let layout = vk.xkb.key_get_layout(key_code);
+        let raw = vk
+            .xkb
+            .get_keymap()
+            .key_get_syms_by_level(key_code, layout, 0)
+            .first()
+            .copied();
+
+        let config = self.niri.config.borrow();
+        let bindings = make_binds_iter(
+            &config,
+            &mut self.niri.window_mru_ui,
+            modifiers_from_state(mods),
+        );
+        let res = should_intercept_key(
+            &mut vk.suppressed_keys,
+            bindings,
+            mod_key,
+            key_code,
+            modified,
+            raw,
+            pressed,
+            mods,
+            &self.niri.screenshot_ui,
+            config.input.disable_power_key_handling,
+            is_inhibiting_shortcuts,
+        );
+        drop(config);
+
+        match res {
+            FilterResult::Forward => false,
+            FilterResult::Intercept(bind) => {
+                if let Some(bind) = bind {
+                    self.handle_bind(bind);
+                }
+                true
+            }
+        }
+    }
